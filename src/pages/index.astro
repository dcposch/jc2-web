---
import Base from '../layouts/Base.astro';
import Math from '../components/Math.astro';
import { SITE, isoDate } from '../consts';
import { publishedEntries } from '../lib/entries';
import { frontier } from '../data/frontier';
import shearSvg from '../figures/shear-grid.svg?raw';

const entries = await publishedEntries();
const goal = '/goal read the README. Your mission is to resolve JC2';
const updated = frontier.updated.slice(0, 16).replace('T', ' ');
---

<Base title="The Road to JC₂">
  <div class="prose">
    <header class="page-head">
      <h1>The Road to JC<sub>2</sub></h1>
      <p class="lede">
        The Jacobian Conjecture fell in higher dimensions. Two variables remain open.
      </p>
      <p>A public campaign to resolve the Plane Jacobian Conjecture, JC<sub>2</sub>.</p>
    </header>

    <figure
      class="statement wide"
      role="figure"
      aria-label="Two panels sharing one coordinate frame. On the left, a square grid. On the right, its image under the shear: horizontal lines stay straight and slide sideways, while vertical lines bend into parabolas."
    >
      <div class="statement__plate" set:html={shearSvg} />
      <Math display tex={String.raw`F(x,y)=(x+y^{2},\,y)`} />
      <figcaption class="statement__gloss">
        A polynomial map with constant nonzero Jacobian. The second coordinate remembers
        the height: subtract its square to undo the slide. JC<sub>2</sub> says every such
        map has a polynomial inverse.
      </figcaption>
    </figure>

    <p class="background-link">
      <a href="/entries/background">What remains open, and why? <span>Read Background →</span></a>
    </p>
    <nav class="page-links" aria-label="On this page">
      <a href="#frontier">Research frontier</a>
      <a href="#contributing">Join the campaign</a>
      <a href="#entries">Selected results</a>
    </nav>

    <h2 id="frontier">Research frontier</h2>
    <p>
      The questions guiding the campaign, with recent results and the gaps they leave.
      JC<sub>2</sub> remains unresolved.
    </p>
    <div class="frontier-meta">
      <time class="label" datetime={frontier.updated}>Updated {updated} UTC</time>
      <a href={frontier.journal}>Daily research log →</a>
    </div>
    <aside class="latest" aria-label="Latest developments">
      <span class="label">Latest developments</span>
      <ul>
        {frontier.questions.slice(0, 2).map((item) => (
          <li>
            <time class="label" datetime={item.date}>{item.date.slice(0, 10)} · {item.date.slice(11, 16)} UTC</time>
            <a href={`#${item.id}`}>{item.headline} →</a>
          </li>
        ))}
      </ul>
    </aside>

    <section class="frontier wide" aria-label="Current research questions">
      <div class="frontier__head label" aria-hidden="true">
        <span>Question</span><span>Latest development</span><span>Next obstacle</span>
      </div>
      {frontier.questions.map((item, index) => (
        <article class="frontier__row" id={item.id} aria-labelledby={`${item.id}-title`}>
          <div class="frontier__question">
            <span class="label frontier__number">{String(index + 1).padStart(2, '0')} / Open question</span>
            <h3 id={`${item.id}-title`}><a href={item.href}>{item.question}</a></h3>
            <p>{item.context}</p>
          </div>
          <div class="frontier__development">
            <span class="label frontier__mobile-label">Latest development</span>
            <div class="frontier__stamp">
              <time datetime={item.date}>{item.date.slice(0, 10)}</time>
              <span class="research-status" data-kind={item.kind}>{item.status}</span>
            </div>
            <p>{item.development}</p>
            <a class="frontier__source" href={item.source}>{'sourceLabel' in item ? item.sourceLabel : 'Read the evidence →'}</a>
            {'report' in item && <a class="frontier__source" href={item.report}>Theorem and proof →</a>}
          </div>
          <div class="frontier__next">
            <span class="label frontier__mobile-label">Next obstacle</span>
            <p>{item.next}</p>
            <a class="frontier__source" href={item.href}>Open problem and context →</a>
          </div>
        </article>
      ))}
    </section>
    <p class="terminus frontier-foot">
      <span>{frontier.credit}. Producer-checked work awaits independent review.</span>
      <a href={frontier.strategy}>Explore the full research map →</a>
    </p>

    <h2 id="contributing">Join the campaign</h2>
    <p class="invitation">Have frontier models? Start a swarm and join the campaign.</p>
    <ol class="join-steps">
      <li><a href={`${SITE.github}/fork`}>Fork the repository</a> and clone your fork.</li>
      <li>Start your coordinator in the local checkout, with access to subagents and shell commands.</li>
      <li>Give it this goal:</li>
    </ol>
    <div class="goal-prompt">
      <code id="swarm-goal">{goal}</code>
      <button type="button" id="copy-goal" aria-label="Copy the swarm goal" hidden>Copy</button>
      <span id="copy-status" class="sr-only" role="status"></span>
    </div>
    <p>
      Contributions are credited on GitHub, and advances highlighted here.
      Have a mathematical idea or question? <a href={`${SITE.github}/issues`}>Open an issue</a>.
    </p>
    <p>
      Humans and AI agents work together, coordinated by <a href={`${SITE.github}/tree/master/team/swarmHQ`}>swarmHQ</a>.
      We show our work: proofs, connections, and failed approaches, with exposition for people and agents alike.
    </p>

    <h2 id="entries">Selected results and explanations</h2>
    <section class="ledger" aria-label="Research essays">
      <ol>
        {entries.map((entry) => (
          <li class="entry-row">
            <time class="label entry-row__date" datetime={isoDate(entry.data.date)}>
              {isoDate(entry.data.date)}
            </time>
            <div>
              <a class="entry-row__title" href={`/entries/${entry.id}`}>{entry.data.title}</a>
              <p class="entry-row__blurb">{entry.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="terminus">{entries.length} essays, oldest first. Further entries appear as they are ready to read.</p>
    </section>
  </div>
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-goal');
  const prompt = document.querySelector('#swarm-goal');
  const status = document.querySelector('#copy-status');
  if (button && prompt && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt.textContent ?? '');
        button.textContent = 'Copied';
        status.textContent = 'Goal copied to clipboard.';
      } catch {
        status.textContent = 'Select the goal text to copy it.';
      }
    });
  }
</script>
