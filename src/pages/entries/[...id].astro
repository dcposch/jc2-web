---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isoDate } from '../../consts';
import { publishedEntries } from '../../lib/entries';

export async function getStaticPaths() {
  const entries = await publishedEntries();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: entries[i - 1] ?? null, next: entries[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="prose entry">
    <header class="page-head">
      <div class="page-head__meta">
        <time class="label" datetime={isoDate(entry.data.date)}>{isoDate(entry.data.date)}</time>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="standfirst">{entry.data.description}</p>
      <hr class="rule page-head__rule" />
    </header>

    <Content />

    <nav class="entry-foot" aria-label="Entries">
      <ul class="pager">
        <li>
          {prev ? (
            <a href={`/entries/${prev.id}`}>
              <span class="label">Previous</span>
              <span class="pager__title">{prev.data.title}</span>
            </a>
          ) : (
            <a href="/#entries"><span class="label">All entries</span><span class="pager__title">The index</span></a>
          )}
        </li>
        {next && (
          <li class="pager__next">
            <a href={`/entries/${next.id}`}>
              <span class="label">Next</span>
              <span class="pager__title">{next.data.title}</span>
            </a>
          </li>
        )}
      </ul>
    </nav>
  </article>
</Base>
