---
import katex from 'katex';
import { KATEX_OPTIONS } from '../lib/katex.mjs';

interface Props {
  /** TeX source. */
  tex: string;
  /** Display (centred, own line) rather than inline. */
  display?: boolean;
}
const { tex, display = false } = Astro.props;

// Rendered here, at build time, so pages ship no math JavaScript.
const html = katex.renderToString(tex, { ...KATEX_OPTIONS, displayMode: display });
---
<Fragment set:html={html} />
