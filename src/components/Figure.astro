---
/**
 * A figure on an .astro page. Markdown uses the :::figure directive instead
 * (src/lib/satteri-figure.mjs); both produce the same markup, so .figure is
 * styled once in global.css.
 */
interface Props {
  /** Basename of a file in src/figures, without the .svg. */
  src: string;
  /** Short rubric label, e.g. "Figure 1". */
  label?: string;
  /** Accessible description of the graphic. Required. */
  alt: string;
  /** Break out past the text measure on wide screens. */
  wide?: boolean;
}
const { src, label, alt, wide = false } = Astro.props;

const figures = import.meta.glob<string>('../figures/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const key = `../figures/${src}.svg`;
if (!(key in figures)) {
  throw new Error(`No figure at src/figures/${src}.svg — run: npm run figures`);
}
const svg = figures[key];
---
<figure class:list={['figure', { wide }]} role="figure" aria-label={alt}>
  <div class="figure__frame" set:html={svg} />
  <figcaption>{label && <b>{label}</b>}<slot /></figcaption>
</figure>
